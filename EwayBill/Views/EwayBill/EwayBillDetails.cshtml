<style>
    .page-title {
        text-align: center;
        margin-bottom: 30px;
        font-size: 2.5em;
        font-weight: bold;
    }

    .button-header {
        display: flex;
        justify-content: center;
        gap: 10px;
        margin-bottom: 30px;
    }

    .custom-header-btn {
        padding: 8px 15px;
        font-size: 1em;
        border-radius: 5px;
        background-color: #6c757d;
        color: #fff;
        text-decoration: none;
        transition: background-color 0.3s ease;
    }

        .custom-header-btn:hover {
            background-color: #5a6268;
        }

    .form-container {
        max-width: 600px;
        margin: 0 auto;
        padding: 20px;
        background-color: #f8f9fa;
        border-radius: 10px;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
    }

    .form-group {
        margin-bottom: 20px;
    }

    .custom-btn {
        padding: 10px 20px;
        font-size: 1.1em;
        border-radius: 6px;
        background-color: #007bff;
        color: #fff;
        border: none;
        transition: background-color 0.3s ease;
        display: block;
        width: 100%;
    }

        .custom-btn:hover {
            background-color: #0056b3;
        }

    .details-container {
        margin-top: 30px;
    }

    .table {
        width: 100%;
        margin-top: 20px;
        border-collapse: collapse;
    }

    .table-bordered th,
    .table-bordered td {
        border: 1px solid #dee2e6;
        padding: 8px;
    }

    .table-bordered th {
        background-color: #f8f9fa;
    }

    .alert-info, .alert-danger {
        text-align: center;
        padding: 15px;
        border-radius: 5px;
    }

    .alert-info {
        background-color: #d1ecf1;
        color: #0c5460;
    }

    .alert-danger {
        background-color: #f8d7da;
        color: #721c24;
    }
</style>

