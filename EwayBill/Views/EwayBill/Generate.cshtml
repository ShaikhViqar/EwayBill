@section Scripts {
    <script>
        $(document).ready(function () {
            var itemIndex = @Model.ItemList.Count;

            // Function to update the indices of the items
            function updateIndices() {
                $('#item-container .item-row').each(function (index) {
                    $(this).find('h4').text('Item ' + (index + 1));
                    $(this).find('input').each(function () {
                        var name = $(this).attr('name');
                        $(this).attr('name', name.replace(/ItemList\[\d+\]/, 'ItemList[' + index + ']'));
                    });
                });
                itemIndex = $('#item-container .item-row').length;
            }

            $('#add-item').click(function () {
                var itemHtml = `
                    <div class="item-row mb-4 p-3 border">
                        <h4>Item ` + (itemIndex + 1) + `</h4>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label>Product Name:</label>
                                <input type="text" name="ItemList[` + itemIndex + `].ProductName" class="form-control" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label>Product Description:</label>
                                <input type="text" name="ItemList[` + itemIndex + `].ProductDesc" class="form-control" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label>HSN Code:</label>
                                <input type="text" name="ItemList[` + itemIndex + `].HsnCode" class="form-control" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label>Quantity:</label>
                                <input type="text" name="ItemList[` + itemIndex + `].Quantity" class="form-control" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label>Quantity Unit:</label>
                                <input type="text" name="ItemList[` + itemIndex + `].QtyUnit" class="form-control" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label>Taxable Amount:</label>
                                <input type="text" name="ItemList[` + itemIndex + `].TaxableAmount" class="form-control" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label>CGST Rate:</label>
                                <input type="text" name="ItemList[` + itemIndex + `].CgstRate" class="form-control" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label>SGST Rate:</label>
                                <input type="text" name="ItemList[` + itemIndex + `].SgstRate" class="form-control" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label>IGST Rate:</label>
                                <input type="text" name="ItemList[` + itemIndex + `].IgstRate" class="form-control" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label>Cess Rate:</label>
                                <input type="text" name="ItemList[` + itemIndex + `].CessRate" class="form-control" />
                            </div>
                        </div>
                        <button type="button" class="btn btn-danger remove-item">Remove Item</button>
                    </div>
                `;
                $('#item-container').append(itemHtml);
                itemIndex++;
            });

            $(document).on('click', '.remove-item', function () {
                $(this).closest('.item-row').remove();
                updateIndices();
            });
        });
    </script>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function() {
        // Function to update Total Invoice Value
        function updateTotalInvoiceValue() {
        const totalValue = parseFloat($('#TotalValue').val()) || 0;
        const cgstValue = parseFloat($('#CgstValue').val()) || 0;
        const sgstValue = parseFloat($('#SgstValue').val()) || 0;
        const igstValue = parseFloat($('#IgstValue').val()) || 0;
        const cessValue = parseFloat($('#CessValue').val()) || 0;
        const cessNonAdvolValue = parseFloat($('#CessNonAdvolValue').val()) || 0;

        const totalInvoiceValue = totalValue + cgstValue + sgstValue + igstValue + cessValue + cessNonAdvolValue;
        $('#TotInvValue').val(totalInvoiceValue.toFixed(2)); // Update Total Invoice Value
        }

        // Attach change event to input fields
        $('#TotalValue, #CgstValue, #SgstValue, #IgstValue, #CessValue, #CessNonAdvolValue').on('input', updateTotalInvoiceValue);
        });
    </script>
}
