@using Newtonsoft.Json
@using Newtonsoft.Json.Serialization

<head>
    <link rel="stylesheet" href="~/Content/Custom.css">
</head>

@model EwayBill.Models.EwayBillResponse

@{
    ViewBag.Title = "E-Way Bill Generated Successfully";
}

<h2 class="text-center my-4">E-Way Bill Generated Successfully</h2>

<div class="button-header">
    <a href="@Url.Action("Index", "EwayBill")" class="btn custom-header-btn">Back to Index</a>
    <a href="@Url.Action("Generate", "EwayBill")" class="btn custom-header-btn">Generate E-Way Bill</a>
    <a href="@Url.Action("EwayBillDetails", "EwayBill")" class="btn custom-header-btn">Go to Details</a>
    <a href="@Url.Action("ViewGenerateResponse", "EwayBill")" class="btn custom-header-btn">View Generate Response</a>
    <a href="@Url.Action("ViewGenerateData", "EwayBill")" class="btn custom-header-btn">View All E-Way Bill</a>
    <a href="@Url.Action("Authenticate", "EwayBill")" class="btn custom-header-btn">Authenticate</a>
</div>



